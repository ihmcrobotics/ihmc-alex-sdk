<?xml version = "1.0" ?>
<robot name="Alexander">

    <!-- LEFT LEG JOINTS -->
    <joint name="LEFT_HIP_X" type="revolute">
        <origin rpy="0 0 0" xyz="-0.162	0.0595	-0.015"/>
        <axis xyz="1 0 0"/>
        <parent link="PELVIS_LINK"/>
        <child link="LEFT_HIP_X_LINK"/>
        <limit effort="150" lower="-0.3490658504" upper="0.872664626" velocity="9"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_HIP_Z" type="revolute">
        <origin rpy="0 0 0" xyz="0.06	0.1	-0.08"/>
        <axis xyz="0 0 1"/>
        <parent link="LEFT_HIP_X_LINK"/>
        <child link="LEFT_HIP_Z_LINK"/>
        <limit effort="60" lower="-0.3490658504" upper="1.0472" velocity="11"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_HIP_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0.1045	-0.0573	-0.0525"/>
        <axis xyz="0 1 0"/>
        <parent link="LEFT_HIP_Z_LINK"/>
        <child link="LEFT_THIGH"/>
        <limit effort="200" lower="-2.61799" upper="0.785398" velocity="8"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_KNEE_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0	0.018	-0.32"/>
        <axis xyz="0 1 0"/>
        <parent link="LEFT_THIGH"/>
        <child link="LEFT_SHIN"/>
        <limit effort="200" lower="0" upper="2.445206282" velocity="8"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_ANKLE_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0	0	-0.41"/>
        <axis xyz="0 1 0"/>
        <parent link="LEFT_SHIN"/>
        <child link="LEFT_ANKLE_Y_LINK"/>
        <limit effort="180" lower="-1.0472" upper="0.523599" velocity="8"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_ANKLE_X" type="revolute">
        <origin rpy="0 0 0" xyz="0	0	-0.012"/>
        <axis xyz="1 0 0"/>
        <parent link="LEFT_ANKLE_Y_LINK"/>
        <child link="LEFT_FOOT"/>
        <limit effort="90" lower="-0.436332" upper="0.436332" velocity="8"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- RIGHT LEG JOINTS -->
    <joint name="RIGHT_HIP_X" type="revolute">
        <origin rpy="0 0 0" xyz="-0.162	-0.0595	-0.015"/>
        <axis xyz="1 0 0"/>
        <parent link="PELVIS_LINK"/>
        <child link="RIGHT_HIP_X_LINK"/>
        <limit effort="150" lower="-0.872664626" upper="0.3490658504" velocity="9"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_HIP_Z" type="revolute">
        <origin rpy="0 0 0" xyz="0.06	-0.1	-0.08"/>
        <axis xyz="0 0 1"/>
        <parent link="RIGHT_HIP_X_LINK"/>
        <child link="RIGHT_HIP_Z_LINK"/>
        <limit effort="60" lower="-1.0472" upper="0.3490658504" velocity="11"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_HIP_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0.1045	0.0573	-0.0525"/>
        <axis xyz="0 1 0"/>
        <parent link="RIGHT_HIP_Z_LINK"/>
        <child link="RIGHT_THIGH"/>
        <limit effort="200" lower="-2.61799" upper="0.785398" velocity="8"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_KNEE_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0	-0.018	-0.32"/>
        <axis xyz="0 1 0"/>
        <parent link="RIGHT_THIGH"/>
        <child link="RIGHT_SHIN"/>
        <limit effort="200" lower="0" upper="2.445206282" velocity="8"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_ANKLE_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0	0	-0.41"/>
        <axis xyz="0 1 0"/>
        <parent link="RIGHT_SHIN"/>
        <child link="RIGHT_ANKLE_Y_LINK"/>
        <limit effort="180" lower="-1.0472" upper="0.523599" velocity="8"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_ANKLE_X" type="revolute">
        <origin rpy="0 0 0" xyz="0	0	-0.012"/>
        <axis xyz="1 0 0"/>
        <parent link="RIGHT_ANKLE_Y_LINK"/>
        <child link="RIGHT_FOOT"/>
        <limit effort="90" lower="-0.436332" upper="0.436332" velocity="8"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- SPINE JOINTS -->
    <joint name="SPINE_Z" type="revolute">
        <origin rpy="0 0 0" xyz="0.0 0 0.018"/> <!-- check with CAD -->
        <axis xyz="0 0 1"/>
        <parent link="PELVIS_LINK"/>
        <child link="TORSO_LINK"/>
        <limit effort="150" lower="-0.5235987756" upper="0.5235987756" velocity="9.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- LEFT ARM JOINTS -->
    <joint name="LEFT_SHOULDER_Y" type="revolute">
        <origin xyz="-0.015 0.115474 0.352984" rpy="0.698132 0.0 0.0"/>
        <axis xyz="0.0 1.0 0.0"/>
        <parent link="TORSO_LINK"/>
        <child link="LEFT_SHOULDER_Y_LINK"/>
        <limit effort="150.0" lower="-3.141592" upper="1.22173" velocity="9.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_SHOULDER_X" type="revolute">
        <origin rpy="-0.698132 0.0 0.0" xyz="0.0 0.15676000 -0.01300000"/>
        <axis xyz="1 0 0"/>
        <parent link="LEFT_SHOULDER_Y_LINK"/>
        <child link="LEFT_SHOULDER_X_LINK"/>
        <limit effort="150.0" lower="-0.349066" upper="2.79253" velocity="9.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_SHOULDER_Z" type="revolute">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.035 -0.08" /> <!-- Z translation for elongated upper arm -->
        <axis xyz="0.0 0.0 1.0" />
        <parent link="LEFT_SHOULDER_X_LINK" />
        <child link="LEFT_SHOULDER_Z_LINK" />
        <limit effort="80.0" lower="-1.91986" upper="1.22173" velocity = "11.5" />
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_ELBOW_Y" type="revolute">
        <origin rpy="0.0 0.0 0.0" xyz="0.015 0.0 -0.3127"/>
        <axis xyz="0.0 1.0 0.0"/>
        <parent link="LEFT_SHOULDER_Z_LINK"/>
        <child link="LEFT_ELBOW_Y_LINK"/>
        <limit effort="80.0" lower="-2.35619" upper="0.174532925" velocity="11.5"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_WRIST_Z" type="revolute">
        <origin xyz="-0.015 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 0.0 1.0"/>
        <parent link="LEFT_ELBOW_Y_LINK"/>
        <child link="LEFT_WRIST_Z_LINK"/>
        <limit effort="20.0" lower="-2.61799" upper="2.61799" velocity="25.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_WRIST_X" type="revolute">
        <origin xyz="0.0 -0.013 -0.25" rpy="0.0 0.0 0.0"/>
        <axis xyz="1 0 0"/>
        <parent link="LEFT_WRIST_Z_LINK"/>
        <child link="LEFT_WRIST_X_LINK"/>
        <limit effort="20.0" lower="-1.8326" upper="0.610865" velocity="25.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_GRIPPER_Z" type="revolute">
        <origin xyz="0.0 0.013 -0.031" rpy="3.14 0.0 0.0"/>
        <axis xyz="0.0 0.0 1.0"/>
        <parent link="LEFT_WRIST_X_LINK"/>
        <child link="base"/>
        <limit effort="20.0" lower="-2.61799" upper="2.61799" velocity="25.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint> 



    <!-- NECK JOINTS -->
    <joint name="NECK_Z" type="revolute">
        <origin rpy="0 0 0" xyz="-0.015 0 0.450403"/>
        <axis xyz="0 0 1"/>
        <parent link="TORSO_LINK"/>
        <child link="NECK_Z_LINK"/>
        <limit effort="20" lower="-1.5708" upper="1.5708" velocity="20"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="NECK_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0.025 0.01 0.189597"/>
        <axis xyz="0 1 0"/>
        <parent link="NECK_Z_LINK"/>
        <child link="HEAD_LINK"/>
        <limit effort="20" lower="-1.0472" upper="1.0472" velocity="20"/>
        <dynamics damping="0.05" friction="0.0"/> 
    </joint>

    <!-- RIGHT ARM JOINTS -->
    <joint name="RIGHT_SHOULDER_Y" type="revolute">
        <origin xyz="-0.015 -0.115474 0.352984" rpy="-0.698132 0.0 0.0" />
        <axis xyz="0.0 1.0 0.0"/>
        <parent link="TORSO_LINK"/>
        <child link="RIGHT_SHOULDER_Y_LINK"/>
        <limit effort="1000" lower="-3.141592" upper="1.22173" velocity="100"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_SHOULDER_X" type="revolute">
        <origin rpy="0.698132 0.0 0.0" xyz="0.0 -0.15676000 -0.01300000"/>
        <axis xyz="1 0 0"/>
        <parent link="RIGHT_SHOULDER_Y_LINK"/>
        <child link="RIGHT_SHOULDER_X_LINK"/>
        <limit effort="1000" lower="-2.79253" upper="0.349066" velocity="100"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_SHOULDER_Z" type="revolute">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.035 -0.08" /> <!-- Z translation for elongated upper arm -->
        <axis xyz="0.0 0.0 1.0" />
        <parent link="RIGHT_SHOULDER_X_LINK" />
        <child link="RIGHT_SHOULDER_Z_LINK" />
         <limit effort="1000" lower="-1.22173" upper="1.91986" velocity = "100" />
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_ELBOW_Y" type="revolute">
        <origin rpy="0.0 0.0 0.0" xyz="0.015 0.0 -0.3127"/>
        <axis xyz="0.0 1.0 0.0"/>
        <parent link="RIGHT_SHOULDER_Z_LINK"/>
        <child link="RIGHT_ELBOW_Y_LINK"/>
        <limit effort="1000" lower="-2.35619" upper="0.174532925" velocity="100"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
     <joint name="RIGHT_WRIST_Z" type="revolute">
        <origin xyz="-0.015 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 0.0 1.0"/>
        <parent link="RIGHT_ELBOW_Y_LINK"/>
        <child link="RIGHT_WRIST_Z_LINK"/>
        <limit effort="20.0" lower="-2.61799" upper="2.61799" velocity="25.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_WRIST_X" type="revolute">
        <origin xyz="0.0 0.013 -0.25" rpy="0.0 0.0 0.0"/>
        <axis xyz="1 0 0"/>
        <parent link="RIGHT_WRIST_Z_LINK"/>
        <child link="RIGHT_WRIST_X_LINK"/>
        <limit effort="20.0" lower="-0.610865" upper="1.8326" velocity="25.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_GRIPPER_Z" type="revolute">
        <origin xyz="0.0 -0.013 -0.031" rpy="3.14 0.0 3.14"/>
        <axis xyz="0.0 0.0 1.0"/>
        <parent link="RIGHT_WRIST_X_LINK"/>
        <child link="base_right"/>
        <limit effort="20.0" lower="-2.61799" upper="2.61799" velocity="25.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>



    <!-- LINKS -->
    <link name="PELVIS_LINK">
        <inertial>
            <mass value="7.161"/> 
            <origin rpy="0 0 0" xyz="-0.08256965 0.00003644 -0.03242784"/>
            <inertia ixx="0.02977256988" ixy="0.00000354246" ixz="0.00058151866" iyy="0.03911256674" iyz="0.00002715104" izz="0.04671200364"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alexander_V1_description/meshes/legs/Pelvis.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
        <collision name="pelvis_collision">
            <geometry>
                    <box size="0.15 0.10 0.12"/>
            </geometry>
            <origin xyz="0.0 0.0 -0.05" rpy="0.0 0.0 0.0"/>
        </collision> 
    </link>
    <!-- pelvis_stim_imu -->
    <joint name="PELVIS_STIM_IMU_JOINT" type="fixed">
        <parent link="PELVIS_LINK"/>
        <child link="PELVIS_STIM_IMU_LINK"/>
        <origin xyz="-0.08687724 0.01225028 -0.08051472" rpy="-0.01399 -0.013054 1.570796"/>
    </joint>

    <link name="PELVIS_STIM_IMU_LINK">
        <inertial>
            <mass value="0.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>

    <gazebo reference="PELVIS_STIM_IMU_LINK">
        <sensor name="pelvis_stim_imu" type="imu">
            <always_on>1</always_on>
            <update_rate>1000.0</update_rate>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                        <bias_mean>0.0000075</bias_mean>
                        <bias_stddev>0.0000008</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>
    <!-- end pelvis imu -->

    <!-- LEFT LEG LINKS -->
    <link name="LEFT_HIP_X_LINK">
        <inertial>
            <mass value="2.332078"/>
            <origin rpy="0 0 0" xyz="0.04350911	0.08708606 -0.03525761"/>
            <inertia ixx="0.00469288" ixy="-0.00059599" ixz="0.00013313" iyy="0.00517742" iyz="0.00048434" izz="0.00554081"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alexander_V1_description/meshes/legs/LeftHipRollLink.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
        <collision name="left_hip_x_collision">
            <geometry>
                <box size="0.02 0.12 0.10"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="-0.02 0.02 0.0"/>
        </collision>
    </link>

    <!-- LeftHipRollIMU-->
	<link name="LEFT_HIP_X_IMU_LINK">
		<inertial>
			<mass value="0"/>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
		</inertial>
	</link>
	<joint name="LEFT_HIP_X_IMU_JOINT" type="fixed">
		<origin rpy="-1.570796 0 1.570796" xyz="-0.01922309 0.10145013 -0.01488788"/>
		<axis xyz="0 0 1"/>
		<parent link="LEFT_HIP_X_LINK"/>
		<child link="LEFT_HIP_X_IMU_LINK"/>
	</joint>
	<gazebo reference="LEFT_HIP_X_IMU_JOINT">
		<sensor name="left_hip_x_imu" type="imu">
			<always_on>true</always_on>
			<imu>
				<noise>
					<type>gaussian</type>
					<rate>
						<mean>0</mean>
						<stddev>0.0002</stddev>
						<bias_mean>7.5e-06</bias_mean>
						<bias_stddev>8e-07</bias_stddev>
					</rate>
					<accel>
						<mean>0</mean>
						<stddev>0.017</stddev>
						<bias_mean>0.1</bias_mean>
						<bias_stddev>0.001</bias_stddev>
					</accel>
				</noise>
			</imu>
		</sensor>
	</gazebo>

    <link name="LEFT_HIP_Z_LINK">
         <inertial>
             <mass value="0.74972192 "/>
             <origin rpy="0 0 0" xyz="0.04549595	-0.00525571	-0.00937454"/>
             <inertia ixx="0.00301724" ixy="-0.00015575" ixz="0.00074098" iyy="0.00328402" iyz="-0.00040842" izz="0.00292463"/>
         </inertial>
         <visual>
             <geometry>
                 <mesh filename="package://alexander_V1_description/meshes/legs/LeftHipYawLink.obj"/>
             </geometry>
             <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
         </visual>
     </link>
     <link name="LEFT_THIGH">
         <inertial>
             <mass value="8.286"/>
             <origin rpy="0 0 0" xyz="0.01417302	0.03268781	-0.10548314"/>
             <inertia ixx="0.09293216" ixy="0.00035382" ixz="0.00924622" iyy="0.09767341" iyz="-0.0043387" izz="0.02812998"/>
         </inertial>
         <visual>
             <geometry>
                 <mesh filename="package://alexander_V1_description/meshes/legs/LeftThigh.obj"/>
             </geometry>
             <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
         </visual>
         <collision name="left_thigh_collision">
             <geometry>
                 <box size="0.16 0.13 0.29"/> <!-- width (X), depth (Y), height (Z) -->
             </geometry>
             <origin rpy="0.0 0.0 0.0" xyz="0.03 0.03 -0.15"/> <!-- Centered along thigh -->
          </collision>
     </link>
    <link name="LEFT_SHIN">
        <inertial>
            <mass value="6.3405718 "/>
            <origin rpy="0 0 0" xyz="0.03807965	-0.00108105	-0.12410027"/>
            <inertia ixx="0.08822008" ixy="-0.00053613" ixz="-0.00634659" iyy="0.091628" iyz="0.00004183" izz="0.01569249"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alexander_V1_description/meshes/legs/LeftShin.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
        </visual>
        <collision name="left_shin_collision">
            <geometry>
                <cylinder radius="0.08" length="0.3"/>  <!-- Adjust based on shin dimensions -->
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.04 0.0 -0.20"/> <!-- Centered along shin -->
        </collision>
    </link>

    <!-- LeftThighIMU-->
    <link name="LEFT_THIGH_IMU_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>
    <joint name="LEFT_THIGH_IMU_JOINT" type="fixed">
        <origin rpy="1.6947717585 0 1.570796" xyz="0.10004 0.03746 -0.21194"/>
        <axis xyz="0 0 1"/>
        <parent link="LEFT_THIGH"/>
        <child link="LEFT_THIGH_IMU_LINK"/>
    </joint>
    <gazebo reference="LEFT_THIGH_IMU_LINK">
        <sensor name="left_thigh_imu" type="imu">
            <always_on>true</always_on>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
                        <stddev>0.0002</stddev>
                        <bias_mean>7.5e-06</bias_mean>
                        <bias_stddev>8e-07</bias_stddev>
                    </rate>
                    <accel>
