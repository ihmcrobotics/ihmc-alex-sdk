        <parent link="LEFT_SHOULDER_Y_LINK"/>
        <child link="LEFT_SHOULDER_Y_IMU_LINK"/>
    </joint>
    <gazebo reference="LEFT_SHOULDER_Y_IMU_LINK">
        <sensor name="left_shoulder_pitch_imu" type="imu">
            <always_on>true</always_on>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
                        <stddev>0.0002</stddev>
                        <bias_mean>7.5e-06</bias_mean>
                        <bias_stddev>8e-07</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0</mean>
                        <stddev>0.017</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>

    <!-- Left Shoulder Yaw IMU -->
    <!-- Note: in CAD this is the left bicep IMU -->
    <link name="LEFT_SHOULDER_Z_IMU_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
     </link>
    <joint name="LEFT_SHOULDER_Z_IMU_JOINT" type="fixed">
        <origin rpy="-1.570796 3.1415926 -0.314159" xyz="-0.00763459 -0.0123324 -0.318"/>
        <axis xyz="0 0 1"/>
        <parent link="LEFT_SHOULDER_Z_LINK"/>
        <child link="LEFT_SHOULDER_Z_IMU_LINK"/>
    </joint>
    <gazebo reference="LEFT_SHOULDER_Z_IMU_LINK">
        <sensor name="left_shoulder_yaw_imu" type="imu">
            <always_on>true</always_on>
                <pose>0 0 0 0 0 0 </pose>
                <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
                        <stddev>0.0002</stddev>
                        <bias_mean>7.5e-06</bias_mean>
                        <bias_stddev>8e-07</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0</mean>
                        <stddev>0.017</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>

    <!-- Right Arm -->
    <link name="RIGHT_SHOULDER_Y_LINK">
        <inertial>
            <mass value="3.00752318 "/>
            <origin rpy="0 0 0" xyz="-0.00264 -0.12135 -0.006824"/>
            <inertia ixx="0.01107924" ixy="-0.00026479" ixz="-0.00015595" iyy="0.00695098" iyz="-0.00308767" izz="0.00991808"/>
