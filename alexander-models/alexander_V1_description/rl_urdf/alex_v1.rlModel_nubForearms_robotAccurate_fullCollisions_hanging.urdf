        </visual>
        <collision name="right_shoulder_z_collision">
           <origin xyz="0 0 -0.12" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.22"/>
            </geometry>
        </collision>
    </link>
    <link name="RIGHT_ELBOW_Y_LINK"> <!-- Using nub forearm to match current physical robot -->
        <inertial>
            <!-- Normal forearm nub -->
            <mass value="0.69372166 "/>
            <origin rpy="0 0 0" xyz="-0.01090935 0.01147189 -0.10388715"/>
            <inertia ixx="0.01372655" ixy="-0.00003374" ixz="-0.00030454" iyy="0.01377871" iyz="-0.00081329" izz="0.0005573" />

