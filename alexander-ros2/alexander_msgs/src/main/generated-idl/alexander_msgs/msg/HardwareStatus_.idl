#ifndef __alexander_msgs__msg__HardwareStatus__idl__
#define __alexander_msgs__msg__HardwareStatus__idl__

#include "alexander_msgs/msg/./ROSDeviceStatusProvider_.idl"
module alexander_msgs
{
  module msg
  {
    module dds
    {

      /**
       * Holds hardware status info of Alexander
       */
      @TypeCode(type="alexander_msgs::msg::dds_::HardwareStatus_")
      struct HardwareStatus
      {
        /**
         * Various fault info
         */
        boolean robot_fault;
        boolean motor_fault;
        boolean missed_deadline_fault;
        boolean working_counter_fault;
        /**
         * Important EtherCAT Stuff
         */
        unsigned long working_counter_mismatch_count;
        unsigned long missed_deadlines;
        /**
         * Joint States
         */
        sequence<alexander_msgs::msg::dds::ROSDeviceStatusProvider, 75> device_status_providers;
      };
    };
  };
};

#endif
