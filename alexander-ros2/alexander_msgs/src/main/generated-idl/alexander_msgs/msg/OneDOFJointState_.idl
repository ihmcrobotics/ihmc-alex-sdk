#ifndef __alexander_msgs__msg__OneDOFJointState__idl__
#define __alexander_msgs__msg__OneDOFJointState__idl__

module alexander_msgs
{
  module msg
  {
    module dds
    {

      /**
       * Holds info for each 1DOF controlled Joint
       */
      @TypeCode(type="alexander_msgs::msg::dds_::OneDOFJointState_")
      struct OneDOFJointState
      {
        string<32> joint_name;
        /**
         * Joint Data
         */
        double q;
        double qd;
        double tau;
        /**
         * Actuator statuses
         */
        double act_temp;
        boolean is_operational;
      };
    };
  };
};

#endif
