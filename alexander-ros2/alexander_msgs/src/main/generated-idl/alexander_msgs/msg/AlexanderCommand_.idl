#ifndef __alexander_msgs__msg__AlexanderCommand__idl__
#define __alexander_msgs__msg__AlexanderCommand__idl__

#include "alexander_msgs/msg/./OneDOFJointCommand_.idl"
module alexander_msgs
{
  module msg
  {
    module dds
    {

      /**
       * Holds desired control commands for Alexander
       */
      @TypeCode(type="alexander_msgs::msg::dds_::AlexanderCommand_")
      struct AlexanderCommand
      {
        /**
         * Operational commands of the robot
         */
        boolean enable_actuators;
        boolean clear_faults;
        boolean calibrate;
        /**
         * Control state of the robot, 0 is do nothing, 1 is hold position, 2 is user control
         */
        octet robot_control_state;
        unsigned long number_of_joints;
        /**
         * Joint Commands for the robot
         */
        sequence<alexander_msgs::msg::dds::OneDOFJointCommand, 50> joint_commands;
        double low_level_master_gain;
      };
    };
  };
};

#endif
