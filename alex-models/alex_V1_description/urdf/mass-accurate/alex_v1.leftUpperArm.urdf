<?xml version = "1.0" ?>
<robot name="Alex">

    <!-- Left Arm -->
    <joint name="LEFT_SHOULDER_Y" type="revolute">
        <origin xyz="-0.015 0.115474 0.352984" rpy="0.698132 0.0 0.0"/>
        <axis xyz="0.0 1.0 0.0"/>
        <parent link="TORSO_LINK"/>
        <child link="LEFT_SHOULDER_Y_LINK"/>
        <limit effort="150.0" lower="-3.141592" upper="1.22173" velocity="9.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="LEFT_SHOULDER_Y_LINK">
        <inertial>
            <mass value="3.0331992"/>
            <origin rpy="0 0 0" xyz="-0.00264 0.12135 -0.006824"/>
            <inertia ixx="0.01114656" ixy="0.00024166" ixz="0.0001507" iyy="0.00699715" iyz="0.00308767" izz="0.0099942"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/cycloidal_arm/LeftShoulderPitchLink.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
    </link>

    <!-- LEFT SHOULDER PITCH IMU Information -->
    <link name="LEFT_SHOULDER_Y_IMU_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>
    <!-- LEFT SHOULDER PITCH IMU Information -->
    <joint name="LEFT_SHOULDER_Y_IMU_JOINT" type="fixed">
        <origin rpy="-1.570796 1.570796 0" xyz="0.0174 0.06944 -0.03025"/>
        <axis xyz="0 0 1"/>
        <parent link="LEFT_SHOULDER_Y_LINK"/>
        <child link="LEFT_SHOULDER_Y_IMU_LINK"/>
    </joint>
    <gazebo reference="LEFT_SHOULDER_Y_IMU_LINK">
        <sensor name="left_shoulder_y_imu" type="imu">
            <always_on>true</always_on>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
                        <stddev>0.0002</stddev>
                        <bias_mean>7.5e-06</bias_mean>
                        <bias_stddev>8e-07</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0</mean>
                        <stddev>0.017</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>

    <joint name="LEFT_SHOULDER_X" type="revolute">
        <origin rpy="-0.698132 0.0 0.0" xyz="0.0 0.15676000 -0.01300000"/>
        <axis xyz="1 0 0"/>
        <parent link="LEFT_SHOULDER_Y_LINK"/>
        <child link="LEFT_SHOULDER_X_LINK"/>
        <limit effort="150.0" lower="-0.349066" upper="2.79253" velocity="9.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="LEFT_SHOULDER_X_LINK">
        <inertial>
            <mass value="1.16160776 "/>
            <origin rpy="0 0 0" xyz="0.01053 0.02124 -0.1052690"/>
            <inertia ixx="0.00786831" ixy="0.00016417" ixz="-0.00075696" iyy="0.00727049" iyz="0.00099239" izz="0.0018045" />
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/cycloidal_arm/LeftShoulderRollLink_shortBicep.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
    </link>

    <joint name="LEFT_SHOULDER_Z" type="revolute">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.035 0.0"/>
        <axis xyz="0.0 0.0 1.0"/>
        <parent link="LEFT_SHOULDER_X_LINK"/>
        <child link="LEFT_SHOULDER_Z_LINK"/>
        <limit effort="80.0" lower="-1.91986" upper="1.22173" velocity="11.5"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="LEFT_SHOULDER_Z_LINK">
        <inertial>
            <mass value="3.134 "/>
            <origin rpy="0 0 0" xyz="0.00510403 0.00274 -0.21745"/>
            <inertia ixx="0.02661157" ixy="0.00000297" ixz="0.00147256" iyy="0.02633278" iyz="0.00039997" izz="0.00308445"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/cycloidal_arm/LeftShoulderYawLink.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0867"/>
        </visual>
    </link>

    <!-- RIGHT SHOULDER YAW IMU -->
    <link name="LEFT_SHOULDER_Z_IMU_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>
    <joint name="LEFT_SHOULDER_Z_IMU_JOINT" type="fixed">
        <origin rpy="-1.570796 3.1415926 -0.314159" xyz="-0.00763459 -0.0123324 -0.318"/>
        <axis xyz="0 0 1"/>
        <parent link="LEFT_SHOULDER_Z_LINK"/>
        <child link="LEFT_SHOULDER_Z_IMU_LINK"/>
    </joint>
    <gazebo reference="LEFT_SHOULDER_Z_IMU_LINK">
        <sensor name="left_shoulder_z_imu" type="imu">
            <always_on>true</always_on>
            <pose>0 0 0 0 0 0</pose>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
                        <stddev>0.0002</stddev>
                        <bias_mean>7.5e-06</bias_mean>
                        <bias_stddev>8e-07</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0</mean>
                        <stddev>0.017</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>
</robot>