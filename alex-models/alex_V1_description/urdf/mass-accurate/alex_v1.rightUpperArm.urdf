<?xml version = "1.0" ?>
<robot name="Alexander">

    <!-- Right Arm -->
    <joint name="RIGHT_SHOULDER_Y" type="revolute">
        <origin xyz="-0.015 -0.115474 0.352984" rpy="-0.698132 0.0 0.0"/>
        <axis xyz="0.0 1.0 0.0"/>
        <parent link="TORSO_LINK"/>
        <child link="RIGHT_SHOULDER_Y_LINK"/>
        <limit effort="1000" lower="-3.141592" upper="1.22173" velocity="100"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="RIGHT_SHOULDER_Y_LINK">
        <inertial>
            <mass value="3.00752318"/>
            <origin rpy="0 0 0" xyz="-0.00264 -0.12135 -0.006824"/>
            <inertia ixx="0.01107924" ixy="-0.00026479" ixz="-0.00015595" iyy="0.00695098" iyz="-0.00308767" izz="0.00991808"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/cycloidal_arm/RightShoulderPitchLink.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
    </link>

    <!-- RIGHT SHOULDER PITCH IMU INFORMATION -->
    <joint name="RIGHT_SHOULDER_Y_IMU_JOINT" type="fixed">
        <origin rpy="1.570796 -1.570796 0" xyz="0.0175 -0.0704 -0.00778"/>
        <axis xyz="0 0 1"/>
        <parent link="RIGHT_SHOULDER_Y_LINK"/>
        <child link="RIGHT_SHOULDER_Y_IMU_LINK"/>
    </joint>
    <link name="RIGHT_SHOULDER_Y_IMU_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>
    <gazebo reference="RIGHT_SHOULDER_Y_IMU_LINK">
        <sensor name="right_shoulder_y_imu" type="imu">
            <always_on>true</always_on>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
                        <stddev>0.0002</stddev>
                        <bias_mean>7.5e-06</bias_mean>
                        <bias_stddev>8e-07</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0</mean>
                        <stddev>0.017</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>

    <joint name="RIGHT_SHOULDER_X" type="revolute">
        <origin rpy="0.698132 0.0 0.0" xyz="0.0 -0.15676000 -0.01300000"/>
        <axis xyz="1 0 0"/>
        <parent link="RIGHT_SHOULDER_Y_LINK"/>
        <child link="RIGHT_SHOULDER_X_LINK"/>
        <limit effort="1000" lower="-2.79253" upper="0.349066" velocity="100"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="RIGHT_SHOULDER_X_LINK">
        <inertial>
            <mass value="1.1615873 "/>
            <origin rpy="0 0 0" xyz="0.01053 -0.02124 -0.1052690"/>
            <inertia ixx="0.00786905" ixy="-0.00016408" ixz="-0.00075601" iyy="0.00727111" iyz="-0.00099114" izz="0.00180465" />
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/cycloidal_arm/RightShoulderRollLink_shortBicep.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
    </link>

    <joint name="RIGHT_SHOULDER_Z" type="revolute">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.035 0.0"/>
        <axis xyz="0.0 0.0 1.0"/>
        <parent link="RIGHT_SHOULDER_X_LINK"/>
        <child link="RIGHT_SHOULDER_Z_LINK"/>
        <limit effort="1000" lower="-1.22173" upper="1.91986" velocity="100"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="RIGHT_SHOULDER_Z_LINK">
        <inertial>
            <mass value="3.10111287"/>
            <origin rpy="0 0 0" xyz="0.00524 -0.00274 -0.21745"/>
            <inertia ixx="0.0262817" ixy="0.00000996" ixz="0.0015423" iyy="0.02606342" iyz="-0.0004047" izz="0.00304834"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/cycloidal_arm/RightShoulderYawLink.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0867"/>
        </visual>
    </link>

    <!-- RIGHT SHOULDER YAW IMU -->
    <joint name="RIGHT_SHOULDER_Z_IMU_JOINT" type="fixed">
        <origin rpy="1.570796 0 0.314159" xyz="0.002 0.016 -0.318"/>
        <axis xyz="0 0 1"/>
        <parent link="RIGHT_SHOULDER_Z_LINK"/>
        <child link="RIGHT_SHOULDER_Z_IMU_LINK"/>
    </joint>

    <link name="RIGHT_SHOULDER_Z_IMU_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>

    <gazebo reference="RIGHT_SHOULDER_Z_IMU_LINK">
        <sensor name="right_shoulder_z_imu" type="imu">
            <always_on>true</always_on>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
                        <stddev>0.0002</stddev>
                        <bias_mean>7.5e-06</bias_mean>
                        <bias_stddev>8e-07</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0</mean>
                        <stddev>0.017</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>

</robot>