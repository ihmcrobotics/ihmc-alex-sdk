<?xml version = "1.0" ?>
<robot name="Alex">
    <joint name="LEFT_NUB_ATTACHMENT" type="fixed">
        <parent link="LEFT_GRIPPER_Z_LINK"/>
        <child link="LEFT_NUB"/>
    </joint>

    <link name="LEFT_NUB">
        <inertial>
            <mass value="0.251"/>
            <origin rpy="0 0 0" xyz="-0.000217 -0.000349 0.009761"/>
            <inertia ixx="0.0000722" ixy="-0.0000016" ixz="-0.0000037" iyy="0.0000747" iyz="0.0000004" izz="0.0000324"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/cycloidal_arm/nub.obj"/>
            </geometry>
            <origin rpy="0.0 1.57 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
    </link>

    <joint name="LEFT_NUB_TIP_FIXED" type="fixed">
        <parent link="LEFT_NUB"/>
        <child link="LEFT_NUB_TIP"/>
        <origin xyz="-0.01 0.0 -0.4" rpy="0 0 0"/>
    </joint>

    <link name="LEFT_NUB_TIP">
        <inertial>
            <mass value="0.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <geometry>
                <sphere radius="0.001"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
    </link>
</robot>