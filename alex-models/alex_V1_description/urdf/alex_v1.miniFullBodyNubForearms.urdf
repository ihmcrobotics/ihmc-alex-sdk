        <axis xyz="0.05 0.0 0.0"/>
        <parent link="LEFT_ANKLE_Y_LINK"/>
        <child link="LEFT_FOOT"/>
        <limit effort="90" lower="-0.436332" upper="0.436332" velocity="8"/>
