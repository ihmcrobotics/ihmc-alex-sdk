     <!-- NECK JOINTS -->
        <joint name="NECK_Z" type="revolute">
            <origin rpy="0 0 0" xyz="-0.00075 0.0 0.022520150000000003"/>
            <axis xyz="0.0 0.0 0.05"/>
            <parent link="TORSO_LINK"/>
            <child link="NECK_Z_LINK"/>
            <limit effort="20" lower="-1.5708" upper="1.5708" velocity="20"/>
            <dynamics damping="0.05" friction="0.0"/>
        </joint>
        <joint name="NECK_Y" type="revolute">
            <origin rpy="0 0 0" xyz="0.0012500000000000002 0.0005 0.00947985"/>
            <axis xyz="0.0 0.05 0.0"/>
            <parent link="NECK_Z_LINK"/>
            <child link="HEAD_LINK"/>
            <limit effort="20" lower="-1.0472" upper="1.0472" velocity="20"/>
            <dynamics damping="0.05" friction="0.0"/>
        </joint>

    <!-- LINKS -->
    <link name="PELVIS_LINK">
        <inertial>
            mass value="0.0011876045437500002"/>
            <origin rpy="0 0 0" xyz="-0.0041771435 2.6455000000000003e-06 -0.0017424140000000003"/>
            <inertia ixx="1.0714650000000003e-08" ixy="3.596875000000001e-12" ixz="4.979687500000001e-11" iyy="1.6183900000000002e-08" iyz="1.4106250000000004e-11" izz="1.8756028125000005e-08"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/legs/Pelvis.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
        <collision name="pelvis_collision">
            <geometry>
                <box size="0.0075 0.005000000000000001 0.006"/>
            </geometry>
            <origin xyz="0.0 0.0 -0.0025000000000000005" rpy="0.0 0.0 0.0"/>
        </collision>
    </link>
    <!-- Pelvis IMU -->
    <joint name="PELVIS_IMU_JOINT" type="fixed">
        <parent link="PELVIS_LINK"/>
        <child link="PELVIS_IMU_LINK"/>
        <origin xyz="-0.0043438619999999995 0.0006125140000000001 -0.004025736" rpy="-0.01399 -0.013054 1.570796"/>
    </joint>

    <link name="PELVIS_IMU_LINK">
        <inertial>
            mass value="0.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>

    <gazebo reference="PELVIS_IMU_LINK">
        <sensor name="pelvis_imu" type="imu">
            <always_on>1</always_on>
            <update_rate>1000.0</update_rate>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                        <bias_mean>0.0000075</bias_mean>
                        <bias_stddev>0.0000008</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>
    <!-- end pelvis imu -->

    <!-- LEFT LEG LINKS -->
