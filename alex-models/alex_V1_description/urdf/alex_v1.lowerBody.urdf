            <!-- Mass is measured by Sean as 1.26 June 9 -->
            <mass value="1.28831268"/>
            <origin rpy="0 0 0" xyz="0.03793372	-0.00000219	-0.0443663"/>
            <inertia ixx="0.0013169" ixy="0.00001054" ixz="0.00036437" iyy="0.00385838" iyz="-0.00000573" izz="0.00406674"/>
