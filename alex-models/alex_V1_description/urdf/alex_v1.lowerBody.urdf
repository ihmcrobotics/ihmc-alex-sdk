            <mass value="8.27617423 "/><!-- CAD Mass 6.31087157 (Hacked April 1 2025 to match IRL Scale of whole robot) -->
            <origin rpy="0 0 0" xyz="0.01411846	-0.03282392	-0.10542795"/>
