<?xml version = "1.0" ?>
<robot name="Alex">

    <!-- Left Arm -->
    <joint name="LEFT_SHOULDER_Y" type="revolute">
        <origin xyz="0.002 0.10350000 0.36000000" rpy="0.698132 0.0 0.0"/>
        <axis xyz="0.0 1.0 0.0"/>
        <parent link="TORSO_LINK"/>
        <child link="LEFT_SHOULDER_Y_LINK"/>
        <limit effort="160.7" lower="-3.141592" upper="1.22173" velocity="10.38"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="LEFT_SHOULDER_Y_LINK">
        <inertial>
            <mass value="3.02036119"/>
            <origin rpy="0 0 0" xyz="-0.00264 0.12135 -0.006824"/>
            <inertia ixx="0.0111129" ixy="0.000253225" ixz="0.000153325" iyy="0.006974065" iyz="0.00308767" izz="0.00995614"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_virtual_description/alex_v1_description/meshes/cycloidal_arm/LeftShoulderPitchLink.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
    </link>

    <joint name="LEFT_SHOULDER_X" type="revolute">
        <origin rpy="-0.698132 0.0 0.0" xyz="0.0 0.15676000 -0.01300000"/>
        <axis xyz="1 0 0"/>
        <parent link="LEFT_SHOULDER_Y_LINK"/>
        <child link="LEFT_SHOULDER_X_LINK"/>
        <limit effort="160.7" lower="-0.349066" upper="2.79253" velocity="10.38"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="LEFT_SHOULDER_X_LINK">
        <inertial>
            <mass value="1.16159753"/>
            <origin rpy="0 0 0" xyz="0.01053 0.02124 -0.1052690"/>
            <inertia ixx="0.00786868" ixy="0.00016417" ixz="-0.000756485" iyy="0.0072708" iyz="0.000991765" izz="0.001804575" />
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_virtual_description/alex_v1_description/meshes/cycloidal_arm/LeftShoulderRollLink_shortBicep.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
    </link>

    <joint name="LEFT_SHOULDER_Z" type="revolute">
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.035 0.0"/>
        <axis xyz="0.0 0.0 1.0"/>
        <parent link="LEFT_SHOULDER_X_LINK"/>
        <child link="LEFT_SHOULDER_Z_LINK"/>
        <limit effort="71.28" lower="-1.91986" upper="1.22173" velocity="4.47"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="LEFT_SHOULDER_Z_LINK">
        <inertial>
            <mass value="3.117556435"/>
            <origin rpy="0 0 0" xyz="0.00510403 0.00274 -0.21745"/>
            <inertia ixx="0.026446635" ixy="0.000006465" ixz="0.00150743" iyy="0.0261981" iyz="0.000402335" izz="0.003066395"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_virtual_description/alex_v1_description/meshes/cycloidal_arm/LeftShoulderYawLink.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0867"/>
        </visual>
        <collision name="left_shoulder_z_collision">
            <origin xyz="0 0 -0.12" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.22"/>
            </geometry>
        </collision>
    </link>

    <!-- LEFT SHOULDER PITCH IMU Information -->
    <joint name="LEFT_SHOULDER_Y_IMU_JOINT" type="fixed">
        <origin rpy="-1.570796 1.570796 0" xyz="0.0174 0.06944 -0.03025"/>
        <axis xyz="0 0 1"/>
        <parent link="LEFT_SHOULDER_Y_LINK"/>
        <child link="LEFT_SHOULDER_Y_IMU_LINK"/>
    </joint>
    <link name="LEFT_SHOULDER_Y_IMU_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>

    <gazebo reference="LEFT_SHOULDER_Y_IMU_LINK">
        <sensor name="left_shoulder_y_imu" type="imu">
            <always_on>true</always_on>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
                        <stddev>0.0002</stddev>
                        <bias_mean>7.5e-06</bias_mean>
                        <bias_stddev>8e-07</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0</mean>
                        <stddev>0.017</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>

    <!-- LEFT SHOULDER YAW IMU -->
    <joint name="LEFT_SHOULDER_Z_IMU_JOINT" type="fixed">
        <origin rpy="-1.570796 3.1415926 -0.314159" xyz="-0.00763459 -0.0123324 -0.318"/>
        <axis xyz="0 0 1"/>
        <parent link="LEFT_SHOULDER_Z_LINK"/>
        <child link="LEFT_SHOULDER_Z_IMU_LINK"/>
    </joint>
    <link name="LEFT_SHOULDER_Z_IMU_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>
    <gazebo reference="LEFT_SHOULDER_Z_IMU_LINK">
        <sensor name="left_shoulder_z_imu" type="imu">
            <always_on>true</always_on>
            <pose>0 0 0 0 0 0</pose>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
                        <stddev>0.0002</stddev>
                        <bias_mean>7.5e-06</bias_mean>
                        <bias_stddev>8e-07</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0</mean>
                        <stddev>0.017</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>
</robot>