<?xml version = "1.0" ?>
<robot name="Alex">
    <!-- Single-body stand-in for the large Ability Hand, attached with alex_v2.rightAbilityHandAdapter.urdf.
         The inertial is the composite of every link of ability_hand_right_large.urdf in the open pose
         (all finger and thumb joints at 0, mimic joints following), expressed in the hand base frame.
         The box bounds the open hand's collision meshes. -->
    <link name="right_ability_hand_base">
        <inertial>
            <mass value="0.48655"/>
            <origin rpy="0 0 0" xyz="-0.008981 -0.006344 0.059623"/>
            <inertia ixx="0.0007060" ixy="0.00001845" ixz="-0.000006654" iyy="0.001161" iyz="0.00008590" izz="0.0005593"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="-0.037 -0.003 0.092"/>
            <geometry>
                <box size="0.157 0.053 0.184"/>
            </geometry>
        </visual>
        <collision name="right_ability_hand_stand_in_collision">
            <origin rpy="0 0 0" xyz="-0.037 -0.003 0.092"/>
            <geometry>
                <box size="0.157 0.053 0.184"/>
            </geometry>
        </collision>
        <!-- Moved from RIGHT_GRIPPER_Z_LINK in alex_v2.rightForearm_convex.urdf -->
        <collision name="right_fist_collision">
            <origin rpy="0.0 0.0 3.14159" xyz="0.0 -0.0175 -0.02"/>
            <geometry>
                <mesh filename="package://alex_virtual_description/alex_v2_description/meshes/cycloidal_arm/RightFist_convex.stl"/>
            </geometry>
        </collision>
    </link>
</robot>
