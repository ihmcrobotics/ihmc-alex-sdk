<?xml version = "1.0" ?>
<robot name="Alex">
    <!-- NECK & HEAD LINKS -->
    <joint name="NECK_Z" type="revolute">
        <origin rpy="0 0 0" xyz="0.0072 0 0.4669"/>
        <axis xyz="0 0 1"/>
        <parent link="TORSO_LINK"/>
        <child link="NECK_Z_LINK"/>
        <limit effort="20.86" lower="-1.5708" upper="1.5708" velocity="17.3"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="NECK_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0.015 -0.01 0.130"/>
        <axis xyz="0 1 0"/>
        <parent link="NECK_Z_LINK"/>
        <child link="HEAD_LINK"/>
        <limit effort="20.86" lower="-0.488692" upper="0.488692" velocity="17.3"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- NECK & HEAD LINKS -->
    <link name="NECK_Z_LINK">
        <inertial>
            <mass value="0.50522843"/>
            <origin rpy="0 0 0" xyz="0.00150863 -0.00038635 0.0372219"/>
            <inertia ixx="0.00165148" ixy="0.00001368" ixz="-0.00006912" iyy="0.00176222" iyz="0.00007727" izz="0.00039986"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V2_description/meshes/neck.obj"/>
            </geometry>
<!--            <material name="gray">-->
<!--                <color rgba="0.05 0.05 0.05 1.0"/>-->
<!--            </material>-->
            <origin rpy="1.5708 0.0 0.0" xyz="0 0 0.0"/>
        </visual>
    </link>
    <link name="HEAD_LINK">
        <inertial>
            <mass value="2.53238993"/>
            <origin rpy="0 0 0" xyz="0.02203239 0.01559991 0.03487138"/>
            <inertia ixx="0.0099523" ixy="0.00038238" ixz="0.00059895" iyy="0.01235238" iyz="0.00044277" izz="0.01250517"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V2_description/meshes/head.obj"/>
            </geometry>
            <origin rpy="1.5708 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
        <collision name="head_collision">
            <origin rpy="1.5708 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://alex_V2_description/meshes/head_convex.stl"/>
            </geometry>
        </collision>
    </link>

    <!-- HEAD IMU -->
    <joint name="HEAD_IMU_JOINT" type="fixed">
        <origin rpy="0.0 0.0 0.0" xyz="-0.02432603 -0.00225290 0.07425800"/>
        <axis xyz="0 0 1"/>
        <parent link="HEAD_LINK"/>
        <child link="HEAD_IMU_LINK"/>
    </joint>

    <link name="HEAD_IMU_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>

    <gazebo reference="HEAD_IMU_LINK">
        <sensor name="head_imu" type="imu">
            <always_on>true</always_on>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
                        <stddev>0.0002</stddev>
                        <bias_mean>7.5e-06</bias_mean>
                        <bias_stddev>8e-07</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0</mean>
                        <stddev>0.017</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>
</robot>
