<?xml version = "1.0" ?>
<robot name="Alex">

    <!-- LEFT LEG JOINTS -->
    <joint name="LEFT_HIP_X" type="revolute">
        <origin rpy="0 0 0" xyz="-0.162	0.0595	-0.015"/>
        <axis xyz="1 0 0"/>
        <parent link="PELVIS_LINK"/>
        <child link="LEFT_HIP_X_LINK"/>
        <limit effort="160.7" lower="-0.488692" upper="0.872665" velocity="10.38"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_HIP_Z" type="revolute">
        <origin rpy="0 0 0" xyz="0.06	0.1	-0.08"/>
        <axis xyz="0 0 1"/>
        <parent link="LEFT_HIP_X_LINK"/>
        <child link="LEFT_HIP_Z_LINK"/>
        <limit effort="70.5" lower="-0.349066" upper="1.0472" velocity="10.59"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_HIP_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0.1045	-0.0573	-0.0525"/>
        <axis xyz="0 1 0"/>
        <parent link="LEFT_HIP_Z_LINK"/>
        <child link="LEFT_THIGH"/>
        <limit effort="217.2" lower="-2.61799" upper="0.785398" velocity="9.3"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_KNEE_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0	0.018	-0.32"/>
        <axis xyz="0 1 0"/>
        <parent link="LEFT_THIGH"/>
        <child link="LEFT_SHIN"/>
        <limit effort="217.2" lower="0" upper="2.44346" velocity="9.3"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_ANKLE_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0	0	-0.41"/>
        <axis xyz="0 1 0"/>
        <parent link="LEFT_SHIN"/>
        <child link="LEFT_ANKLE_Y_LINK"/>
        <limit effort="193.6" lower="-1.0472" upper="0.523599" velocity="9.72"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="LEFT_ANKLE_X" type="revolute">
        <origin rpy="0 0 0" xyz="0	0	-0.012"/>
        <axis xyz="1 0 0"/>
        <parent link="LEFT_ANKLE_Y_LINK"/>
        <child link="LEFT_FOOT"/>
        <limit effort="145.2" lower="-0.436332" upper="0.436332" velocity="9.72"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- RIGHT LEG JOINTS -->
    <joint name="RIGHT_HIP_X" type="revolute">
        <origin rpy="0 0 0" xyz="-0.162	-0.0595	-0.015"/>
        <axis xyz="1 0 0"/>
        <parent link="PELVIS_LINK"/>
        <child link="RIGHT_HIP_X_LINK"/>
        <limit effort="160.7" lower="-0.872665" upper="0.488692" velocity="10.38"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_HIP_Z" type="revolute">
        <origin rpy="0 0 0" xyz="0.06	-0.1	-0.08"/>
        <axis xyz="0 0 1"/>
        <parent link="RIGHT_HIP_X_LINK"/>
        <child link="RIGHT_HIP_Z_LINK"/>
        <limit effort="70.5" lower="-1.0472" upper="0.349066" velocity="10.59"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_HIP_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0.1045	0.0573	-0.0525"/>
        <axis xyz="0 1 0"/>
        <parent link="RIGHT_HIP_Z_LINK"/>
        <child link="RIGHT_THIGH"/>
        <limit effort="217.2" lower="-2.61799" upper="0.785398" velocity="9.3"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_KNEE_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0	-0.018	-0.32"/>
        <axis xyz="0 1 0"/>
        <parent link="RIGHT_THIGH"/>
        <child link="RIGHT_SHIN"/>
        <limit effort="217.2" lower="0" upper="2.44346" velocity="9.3"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_ANKLE_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0	0	-0.41"/>
        <axis xyz="0 1 0"/>
        <parent link="RIGHT_SHIN"/>
        <child link="RIGHT_ANKLE_Y_LINK"/>
        <limit effort="193.6" lower="-1.0472" upper="0.523599" velocity="9.72"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <joint name="RIGHT_ANKLE_X" type="revolute">
        <origin rpy="0 0 0" xyz="0	0	-0.012"/>
        <axis xyz="1 0 0"/>
        <parent link="RIGHT_ANKLE_Y_LINK"/>
        <child link="RIGHT_FOOT"/>
        <limit effort="145.2" lower="-0.436332" upper="0.436332" velocity="9.72"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- SPINE JOINTS -->
    <joint name="SPINE_Z" type="revolute">
        <origin rpy="0 0 0" xyz="0.0 0 0.018"/> <!-- check with CAD -->
        <axis xyz="0 0 1"/>
        <parent link="PELVIS_LINK"/>
        <child link="TORSO_LINK"/>
        <limit effort="160.7" lower="-0.523599" upper="0.523599" velocity="10.38"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- LINKS -->
    <link name="PELVIS_LINK">
        <inertial>
            <!-- Mass is measured by Sean as 7.700 on June 9 -->
            <mass value="7.161"/>
            <origin rpy="0 0 0" xyz="-0.08256965 0.00003644 -0.03242784"/>
            <inertia ixx="0.02977256988" ixy="0.00000354246" ixz="0.00058151866" iyy="0.03911256674" iyz="0.00002715104" izz="0.04671200364"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/legs/Pelvis.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
        <collision name="pelvis_collision">
            <geometry>
                <box size="0.15 0.10 0.12"/>
            </geometry>
            <origin xyz="0.0 0.0 -0.05" rpy="0.0 0.0 0.0"/>
        </collision>
    </link>
    <!-- Pelvis IMU -->
    <joint name="PELVIS_IMU_JOINT" type="fixed">
        <parent link="PELVIS_LINK"/>
        <child link="PELVIS_IMU_LINK"/>
        <origin xyz="-0.08687724 0.01225028 -0.08051472" rpy="-0.01399 -0.013054 1.570796"/>
    </joint>
    <link name="PELVIS_IMU_LINK">
        <inertial>
            <mass value="0.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>
    <gazebo reference="PELVIS_IMU_LINK">
        <sensor name="pelvis_imu" type="imu">
            <always_on>1</always_on>
            <update_rate>1000.0</update_rate>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0.0</mean>
                        <stddev>2e-4</stddev>
                        <bias_mean>0.0000075</bias_mean>
                        <bias_stddev>0.0000008</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0.0</mean>
                        <stddev>1.7e-2</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>
    <!-- end pelvis imu -->

    <!-- LEFT LEG LINKS -->
    <link name="LEFT_HIP_X_LINK">
        <inertial>
            <!-- Mass is measured by Sean as 1.933 on June 9 -->
            <mass value="2.33165613"/>
            <origin rpy="0 0 0" xyz="0.04351434	0.086987705 -0.03525559"/>
            <inertia ixx="0.00468897" ixy="-0.00060313" ixz="0.000132015" iyy="0.005175225" iyz="0.000479295" izz="0.00553563"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/legs/LeftHipRollLink.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
        <collision name="left_hip_x_collision">
            <geometry>
                <box size="0.02 0.12 0.10"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="-0.02 0.06 0.0"/>
        </collision>
    </link>
    <!-- LeftHipRollIMU-->
    <link name="LEFT_HIP_X_IMU_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>
    <joint name="LEFT_HIP_X_IMU_JOINT" type="fixed">
        <origin rpy="-1.570796 0 1.570796" xyz="-0.01922309 0.10145013 -0.01488788"/>
        <axis xyz="0 0 1"/>
        <parent link="LEFT_HIP_X_LINK"/>
        <child link="LEFT_HIP_X_IMU_LINK"/>
    </joint>
    <gazebo reference="LEFT_HIP_X_IMU_LINK">
        <sensor name="left_hip_x_imu" type="imu">
            <always_on>true</always_on>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
                        <stddev>0.0002</stddev>
                        <bias_mean>7.5e-06</bias_mean>
                        <bias_stddev>8e-07</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0</mean>
                        <stddev>0.017</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>

    <link name="LEFT_HIP_Z_LINK">
        <inertial>
            <!-- Mass is measured by Sean as 0.777 on June 9 -->
            <mass value="0.761264535"/>
            <origin rpy="0 0 0" xyz="0.045494345 -0.005256775 -0.009374795"/>
            <inertia ixx="0.003096815" ixy="-0.00010691" ixz="0.00077348" iyy="0.00336791" iyz="-0.000441415" izz="0.00302853"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/legs/LeftHipYawLink.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
        </visual>
    </link>
    <link name="LEFT_THIGH">
        <inertial>
            <!-- Mass is measured by Sean as 8.200 on June 9 -->
            <mass value="8.281087115"/> <!-- CAD Mass 6.31087157 (Hacked April 1 2025 to match IRL Scale of whole robot) -->
            <origin rpy="0 0 0" xyz="0.01414574	0.032755865 -0.105455545"/>
            <inertia ixx="0.092873595" ixy="0.00029855" ixz="0.00920838" iyy="0.09755584" iyz="-0.004288545" izz="0.028067205"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/legs/LeftThigh.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
        </visual>
        <collision name="left_thigh_collision">
            <geometry>
                <box size="0.13 0.13 0.29"/> <!-- width (X), depth (Y), height (Z) -->
            </geometry>
            <origin rpy="0.0 -0.15 0.0" xyz="0.03 0.03 -0.15"/> <!-- Centered along thigh -->
        </collision>
    </link>
    <link name="LEFT_SHIN">
        <inertial>
            <!-- Mass is measured by Sean as 7.400 on June 9 -->
            <mass value="6.33845554"/><!-- CAD Mass 6.31087157 (Hacked April 1 2025 to match IRL Scale of whole robot) -->
            <origin rpy="0 0 0" xyz="0.038078065 -0.0011074	-0.12409396"/>
            <inertia ixx="0.08776112" ixy="-0.000537525" ixz="-0.006473595" iyy="0.091103" iyz="0.000168055" izz="0.01567633"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/legs/LeftShin.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
        </visual>
        <collision name="left_shin_collision">
            <geometry>
                <cylinder radius="0.06" length="0.3"/>  <!-- Adjust based on shin dimensions -->
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.04 0.0 -0.20"/> <!-- Centered along shin -->
        </collision>
    </link>
    <!-- LeftThighIMU-->
    <link name="LEFT_THIGH_IMU_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>
    <joint name="LEFT_THIGH_IMU_JOINT" type="fixed">
        <origin rpy="1.437982 0 1.570796" xyz="0.10004 0.03746 -0.21194"/>
        <axis xyz="0 0 1"/>
        <parent link="LEFT_THIGH"/>
        <child link="LEFT_THIGH_IMU_LINK"/>
    </joint>
    <gazebo reference="LEFT_THIGH_IMU_LINK">
        <sensor name="left_thigh_imu" type="imu">
            <always_on>true</always_on>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
