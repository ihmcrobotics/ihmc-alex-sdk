<?xml version = "1.0" ?>
<robot name="Alex">
    <!-- NECK, & HEAD JOINTS -->
    <joint name="NECK_Z" type="revolute">
        <origin rpy="0 0 0" xyz="0.0072 0 0.4669"/>
        <axis xyz="0 0 1"/>
        <parent link="TORSO_LINK"/>
        <child link="NECK_Z_LINK"/>
        <limit effort="20.86" lower="-1.22173" upper="1.22173" velocity="17.3"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <joint name="NECK_Y" type="revolute">
        <origin rpy="0 0 0" xyz="0.015 -0.013 0.130"/>
        <axis xyz="0 1 0"/>
        <parent link="NECK_Z_LINK"/>
        <child link="HEAD_LINK"/>
        <limit effort="20.86" lower="-0.488692" upper="0.488692" velocity="17.3"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- TORSO, NECK, & HEAD LINKS -->
    <link name="TORSO_LINK">
        <inertial>
            <mass value="15.84880155"/>
            <origin rpy="0 0 0" xyz="0.00370028 0.00073303 0.28264062"/>
            <inertia ixx="0.33263586" ixy="0.00038117" ixz="0.01866859" iyy="0.29657817" iyz="0.0008414" izz="0.17525439"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_purdue_description/meshes/torso_head/torso_purdue.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0 0 0.0"/>
        </visual>
    </link>

    <link name="NECK_Z_LINK">
        <inertial>
            <mass value="0.35018021"/>
            <origin rpy="0 0 0" xyz="0.00219772 -0.00061535 0.0631763"/>
            <inertia ixx="0.00083944" ixy="0.00001358" ixz="-0.00004823" iyy="0.00094957" iyz="0.0000706" izz="0.00037861"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_purdue_description/meshes/torso_head/neck_purdue.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0 0 0.0"/>
        </visual>
    </link>

    <link name="HEAD_LINK">
        <inertial>
            <mass value="2.53238993"/>
            <origin rpy="0 0 0" xyz="0.02203239 0.01559991 0.03487138"/>
            <inertia ixx="0.0099523" ixy="0.00038238" ixz="0.00059895" iyy="0.01235238" iyz="0.00044277" izz="0.01250517"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_purdue_description/meshes/torso_head/head_purdue.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
        <collision name="head_collision">
            <origin xyz="0.03237 -0.013568 0.007163" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.14"/>
            </geometry>
        </collision>
    </link>

    <!-- HEAD ZED X MINI -->
    <joint name="HEAD_ZED_X_MINI_JOINT" type="fixed">
        <origin rpy="0.0 0.3633 0.0" xyz="0.11603 0.009965 -0.02983"/>
        <parent link="HEAD_LINK"/>
        <child link="HEAD_ZED_X_MINI_LINK"/>
    </joint>
    <link name="HEAD_ZED_X_MINI_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="package://alex_V1_description/meshes/ZEDXMini.obj"/>
            </geometry>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
    </link>

    <!-- HEAD IMU -->
    <joint name="HEAD_IMU_JOINT" type="fixed">
        <origin rpy="0.0 0.0 0.0" xyz="-0.02432603 -0.00225290 0.07425800"/>
        <axis xyz="0 0 1"/>
        <parent link="HEAD_LINK"/>
        <child link="HEAD_IMU_LINK"/>
    </joint>
    <link name="HEAD_IMU_LINK">
        <inertial>
            <mass value="0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>
    <gazebo reference="HEAD_IMU_LINK">
        <sensor name="head_imu" type="imu">
            <always_on>true</always_on>
            <imu>
                <noise>
                    <type>gaussian</type>
                    <rate>
                        <mean>0</mean>
                        <stddev>0.0002</stddev>
                        <bias_mean>7.5e-06</bias_mean>
                        <bias_stddev>8e-07</bias_stddev>
                    </rate>
                    <accel>
                        <mean>0</mean>
                        <stddev>0.017</stddev>
                        <bias_mean>0.1</bias_mean>
                        <bias_stddev>0.001</bias_stddev>
                    </accel>
                </noise>
            </imu>
        </sensor>
    </gazebo>
</robot>